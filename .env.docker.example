# Copy this file to .env (next to docker-compose.yml), then set a random token.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=replace-with-a-long-random-token
APP_PORT=8787
APP_TIMEZONE=Asia/Shanghai
APP_COLLECTOR_OFFLINE_SECONDS=180
APP_STALE_MINUTES=120
