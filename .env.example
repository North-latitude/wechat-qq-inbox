# Leave blank to auto-generate a random token at backend/data/token.txt on first start.
# Or set your own long random token. The Android app and browser use the same token.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=

# SQLite file. Relative paths resolve from the repository root.
APP_DB_PATH=backend/data/inbox.db

# IANA timezone used for "today" counters and display defaults.
APP_TIMEZONE=Asia/Shanghai

# Collector is considered offline if no heartbeat arrives within this many seconds.
APP_COLLECTOR_OFFLINE_SECONDS=180

# Show "possibly offline" when no matched message has arrived for this long.
APP_STALE_MINUTES=120

# Comma-separated extra allowed WebSocket origins. Empty = same host only.
APP_ALLOWED_ORIGINS=
