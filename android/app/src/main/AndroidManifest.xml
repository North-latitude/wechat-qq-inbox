<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".InboxApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnifiedInbox"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.InboxActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.UnifiedInbox.Compose">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".ui.RulesActivity"
            android:exported="false"
            android:label="@string/rules_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.HitLogActivity"
            android:exported="false"
            android:label="@string/hit_log_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.KeepAliveActivity"
            android:exported="false"
            android:label="@string/keep_alive_title"
            android:parentActivityName=".ui.MainActivity" />

        <service
            android:name=".collector.InboxNotificationListenerService"
            android:exported="true"
            android:label="@string/listener_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".boot.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
